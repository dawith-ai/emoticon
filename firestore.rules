rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────
    // 헬퍼 함수
    // ─────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.admin == true;
    }

    // ─────────────────────────────────────────
    // users/{userId}
    // ─────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // 가입 시 생성은 Cloud Function이 담당. 클라이언트는 displayName/photoURL만 갱신
      allow create: if isOwner(userId)
                    && request.resource.data.credits == 5  // 무료 5 크레딧 (시드 1장 체험)
                    && request.resource.data.email is string;
      allow update: if isOwner(userId)
                    && (!('credits' in request.resource.data)
                        || request.resource.data.credits == resource.data.credits);  // 클라이언트 크레딧 조작 불가
      allow delete: if false;  // 회원 탈퇴는 Function으로

      // users/{userId}/projects/{projectId}
      match /projects/{projectId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);

        // users/{userId}/projects/{projectId}/stickers/{stickerId}
        match /stickers/{stickerId} {
          allow read: if isOwner(userId);
          // 스티커 메타데이터 쓰기는 Function이 담당 (AI 생성 후)
          allow write: if false;
        }
      }

      // users/{userId}/loras/{trainingId} — Replicate LoRA 학습 결과 영속화
      // Replicate 토큰은 BYOK라 클라이언트가 학습 비용 결제 → 결과 메타만 동기화
      match /loras/{trainingId} {
        allow read, write, delete: if isOwner(userId);
      }

      // users/{userId}/submissions/{submissionId} — 카카오 제출 결과 옵트인 데이터
      // 합격/거절 결과를 모아 코치 정확도를 높이는 플라이휠. 본인만 읽기/쓰기.
      match /submissions/{submissionId} {
        allow read, write, delete: if isOwner(userId);
      }
    }

    // ─────────────────────────────────────────
    // credits/transactions/{txId} — 크레딧 거래 내역
    // 모든 쓰기는 Function 전용. 클라이언트는 자기 거래만 읽기 가능.
    // ─────────────────────────────────────────
    match /credits/transactions/{txId} {
      allow read: if isSignedIn()
                  && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ─────────────────────────────────────────
    // platforms/{platformId} — 플랫폼 마스터 데이터 (모두 read-only)
    // ─────────────────────────────────────────
    match /platforms/{platformId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // public/{topic}/{collection}/{itemId} — 베타 대기열, 자료 제보 등
    // 누구나 한 번 쓸 수 있고, 읽기/수정/삭제는 관리자만.
    // topic 화이트리스트 + 페이로드 필수 필드 검증으로 어뷰즈 방지.
    match /public/{topic}/{collection}/{itemId} {
      allow create: if (topic == "waitlist" || topic == "resource_submissions")
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.size() < 30;  // 필드 30개 미만
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────
    // 그 외 모든 경로는 차단
    // ─────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
