# ─────────────────────────────────────────────────────────
# AI 이미지 생성
# ─────────────────────────────────────────────────────────
# Gemini API (Nano Banana 이미지 생성 + LLM-judge 평가)
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Replicate (P1 정밀 모드 — SDXL+LoRA)
# 발급: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# ─────────────────────────────────────────────────────────
# Firebase 클라이언트 (NEXT_PUBLIC_* 은 브라우저에 노출됨)
# firebase apps:create WEB VibeMoji --project vibemoji-app
# firebase apps:sdkconfig WEB --project vibemoji-app
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vibemoji-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────
# 분석 / 모니터링 (모두 선택 사항 — 미설정 시 noop)
# ─────────────────────────────────────────────────────────
# PostHog 분석 (사용자 동의 시에만 활성화)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry 에러 추적
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_RELEASE=dev

# ─────────────────────────────────────────────────────────
# 배포
# ─────────────────────────────────────────────────────────
# 사이트 정식 URL (sitemap.xml, robots.txt, OG image canonical용)
NEXT_PUBLIC_SITE_URL=https://myjun090-spec.github.io/emoticon
