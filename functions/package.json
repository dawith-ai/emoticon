    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "archiver": "^7.0.1",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.1.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
